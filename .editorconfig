# EditorConfig is awesome: https://EditorConfig.org

# This file is the top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false

# git
[.git*]
indent_style = tab
indent_size = 4

# Shell scripts
[*.{sh,bash}]
charset = utf-8
end_of_line = lf
indent_style = space
# like -i=2
indent_size = 2
trim_trailing_whitespace = false
insert_final_newline = false
#shell_variant      = bash
#shell_variant      = posix # like -ln=posix
#binary_next_line   = true  # like -bn
#switch_case_indent = true  # like -ci
#space_redirects    = true  # like -sr
#keep_padding       = true  # like -kp
#function_next_line = true  # like -fn
#never_split        = true  # like -ns

[*.{py,pyi}]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
max_line_length = 119
trim_trailing_whitespace = true
insert_final_newline = true

[Makefile]
indent_style = tab
indent_size = 4

[justfile]
indent_style = space
indent_size = 4

[*.xml]
indent_style = space
indent_size = 2

[*.{json,json5}]
indent_style = space
indent_size = 2

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.toml]
indent_style = space
indent_size = 4

[*.ini]
indent_style = space
indent_size = 4
trim_trailing_whitespace = false
insert_final_newline = true

[*.{md,mdx}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

